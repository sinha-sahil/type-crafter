/**
 * @type { {{typeName}} }
 {{#if description}}
 * @description {{{description}}}
 {{/if}}
 {{#if example}}
 * @example {{{example}}}
 {{/if}}
 */
export type {{typeName}} = {{#if (not (isEmptyObject properties))}}{
  {{#each properties}}
  /**
  {{#if this.description}}
   * @description {{{this.description}}}
  {{/if}}
   * @type { {{this.type}} }
   * @memberof {{../typeName}}
  {{#if this.example}}
   * @example {{{this.example}}}
  {{/if}}
  */
  {{#if this.required}}
  {{{jsonKey @key}}}: {{{this.type}}};
  {{else if this.optional}}
  {{{jsonKey @key}}}?: {{{this.type}}};
  {{else}}
  {{{jsonKey @key}}}: {{{this.type}}} | null;
  {{/if}}
  {{/each}}
  {{#if additionalProperties}}
  [keys: {{jsonKey additionalProperties.keyType}}]: {{additionalProperties.valueType}};
  {{/if}}
};
{{else if (or (notEq length additionalProperties 0) (not (isEmptyObject additionalProperties)))}}
Record<{{jsonKey additionalProperties.keyType}}, {{additionalProperties.valueType}}>;
{{/if}}

{{#unless customAttributes.skipDecoderGeneration}}
export function decode{{typeName}}(rawInput: unknown): {{typeName}} | null {
  if (isJSON(rawInput)) {
    {{#each properties}}
    const decoded{{variableName @key}} = {{#if this.referenced ~}}
      {{#if this.optional}}_{{/if}}decode{{{toPascalCase this.type}}}(rawInput[{{{indexKey @key}}}]);
    {{~else~}}
      {{~#if (eq this.primitiveType 'array')~}} 
      decodeArray(rawInput[{{{indexKey @key}}}], decode{{{toPascalCase this.composerType}}})
      {{~else~}}
       {{#if this.optional}}_{{/if}}decode{{{toPascalCase this.type}}}(rawInput[{{{indexKey @key}}}])
      {{~/if~}};
    {{~/if}}

    {{/each}}

    {{#if (areRequiredKeysPresent properties)}}
    if (
      {{#each (getRequiredKeys properties)}}
      decoded{{toPascalCase this}} === null{{#unless @last}} ||{{/unless}}
      {{/each}}
    ) {
      return null;
    }
    {{/if}}

    {{#if additionalProperties}}
    {{#if (isEmptyObject properties)}}
    const decodedAdditionalProperties: {{typeName}} = {};
    for (const key in rawInput) {
      {{#if additionalProperties.valueTypeReferenced}}
      const decodedValue = {{#if (eq additionalProperties.valuePrimitiveType 'array')~}}
        decodeArray(rawInput[key], decode{{{toPascalCase additionalProperties.valueComposerType}}});
      {{~else~}}
        decode{{{toPascalCase additionalProperties.valueType}}}(rawInput[key]);
      {{~/if}}
      {{else}}
      {{#if (eq additionalProperties.valuePrimitiveType 'array')}}
      const decodedValue = decodeArray(rawInput[key], decode{{{toPascalCase additionalProperties.valueComposerType}}});
      {{else}}
      const decodedValue = decode{{{toPascalCase additionalProperties.valueType}}}(rawInput[key]);
      {{/if}}
      {{/if}}
      if (decodedValue === null) {
        return null;
      }
      decodedAdditionalProperties[key] = decodedValue;
    }
    return decodedAdditionalProperties;
    {{else}}
    const decodedAdditionalProperties: Record<{{additionalProperties.keyType}}, {{additionalProperties.valueType}}> = {};
    const knownKeys = new Set([{{#each properties}}{{{indexKey @key}}}{{#unless @last}}, {{/unless}}{{/each}}]);
    for (const key in rawInput) {
      if (!knownKeys.has(key)) {
        {{#if additionalProperties.valueTypeReferenced}}
        const decodedValue = {{#if (eq additionalProperties.valuePrimitiveType 'array')~}}
          decodeArray(rawInput[key], decode{{{toPascalCase additionalProperties.valueComposerType}}});
        {{~else~}}
          decode{{{toPascalCase additionalProperties.valueType}}}(rawInput[key]);
        {{~/if}}
        {{else}}
        {{#if (eq additionalProperties.valuePrimitiveType 'array')}}
        const decodedValue = decodeArray(rawInput[key], decode{{{toPascalCase additionalProperties.valueComposerType}}});
        {{else}}
        const decodedValue = decode{{{toPascalCase additionalProperties.valueType}}}(rawInput[key]);
        {{/if}}
        {{/if}}
        if (decodedValue === null) {
          return null;
        }
        decodedAdditionalProperties[key] = decodedValue;
      }
    }
    return {
      ...decodedAdditionalProperties,
      {{#each properties}}
      {{{jsonKey @key}}}: decoded{{{variableName @key}}}{{#unless @last}},{{/unless}}
      {{/each}}
    };
    {{/if}}
    {{else}}
    return {
      {{#each properties}}
      {{{jsonKey @key}}}: decoded{{{variableName @key}}}{{#unless @last}},{{/unless}}
      {{/each}}
    };
    {{/if}}
  }
  return null;
}
{{/unless}}

